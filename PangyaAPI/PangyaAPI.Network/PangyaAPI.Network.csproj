<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>PangyaAPI.Network</RootNamespace>
    <AssemblyName>PangyaAPI.Network</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CS0612;CS0618;CS0675;CS8073;CS8981;CS9125;CA1416;CA2022;CA2200;CA2255;SYSLIB0021;SYSLIB0051</NoWarn>
    <PackageId>PangyaAPI.Network</PackageId>
    <Title>PangyaAPI Network</Title>
    <Description>Networking, packet, session, and server runtime components for PangYa services.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="PangyaAPI.IFF.JP" Version="1.0.0-local.1" />
    <ProjectReference Include="..\PangyaAPI.IFF\PangyaAPI.IFF.csproj" />
    <ProjectReference Include="..\PangyaAPI.SQL\PangyaAPI.SQL.csproj" />
    <ProjectReference Include="..\PangyaAPI.Utilities\PangyaAPI.Utilities.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
